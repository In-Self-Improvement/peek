{
  "manifest_version": 3,
  "name": "peek — click UI, prompt your AI",
  "short_name": "peek",
  "version": "1.1.0",
  "description": "Click any element on a web page, write what to change, and copy a precise prompt for Claude Code, Cursor or Codex.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "peek 켜기/끄기 (Alt+Shift+P)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "peek 켜기/끄기"
    }
  },
  "web_accessible_resources": [
    { "resources": ["content.css"], "matches": ["<all_urls>"] }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
