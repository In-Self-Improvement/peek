{
  "manifest_version": 3,
  "name": "peek",
  "version": "1.0.0",
  "description": "Hover over any web element to find its code identifier instantly",
  "permissions": ["activeTab", "clipboardWrite"],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Toggle peek"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }],
  "background": {
    "service_worker": "background.js"
  }
}
